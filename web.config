<?xml version="1.0" encoding="utf-8"?>
<!--
  ═══════════════════════════════════════════════════════════════════════════════
  web.config — IIS / Plesk + iisnode
  App:  hr-duongminh ERP API
  Entry: app.js → require('./dist/main') → NestJS bootstrap
  ═══════════════════════════════════════════════════════════════════════════════
-->
<configuration>
  <system.webServer>

    <!-- ─── Handler: route tất cả request qua iisnode ─────────────────────── -->
    <handlers>
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- ─── URL Rewrite: chuyển mọi URL → app.js ──────────────────────────── -->
    <rewrite>
      <rules>
        <!-- Bỏ qua các file static thật sự (nếu có) -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="([\S]+[.](jpg|jpeg|gif|css|png|js|ico|html|xml|svg|woff|woff2|ttf|eot))" />
          <action type="None" />
        </rule>

        <!-- Tất cả request còn lại → NestJS app -->
        <rule name="NodeJS" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>

    <!-- ─── iisnode configuration ─────────────────────────────────────────── -->
    <iisnode
      nodeProcessCommandLine="&quot;%programfiles%\nodejs\node.exe&quot;"

      <!-- Log stdout/stderr của Node process vào thư mục iisnode\ -->
      loggingEnabled="true"
      logDirectory="iisnode"

      <!-- Hiện lỗi chi tiết khi debug (đặt false trên production thật sự) -->
      devErrorsEnabled="false"

      <!-- Số process Node chạy song song (thường = CPU cores) -->
      nodeProcessCountPerApplication="1"

      <!-- Tự restart nếu process crash -->
      maxConcurrentRequestsPerProcess="1024"
      maxNamedPipeConnectionRetry="100"
      namedPipeConnectionRetryDelay="250"

      <!-- Graceful recycling khi deploy code mới -->
      recycleSignalEnabled="false"
      idlePageOutTimePeriod="0"

      <!-- Watch app.js → tự restart khi file thay đổi (disable trên prod) -->
      watchedFiles="web.config;*.js"
    />

    <!-- ─── Security headers ──────────────────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- ─── Ẩn thông tin server (bảo mật) ────────────────────────────────── -->
    <security>
      <requestFiltering removeServerHeader="true" />
    </security>

    <!-- ─── Default document ──────────────────────────────────────────────── -->
    <defaultDocument enabled="false" />

    <!-- ─── Error pages ───────────────────────────────────────────────────── -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
