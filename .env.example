# Application
NODE_ENV=production
PORT=3000
# Plesk/IIS normally adds one trusted reverse-proxy hop. Use 2 when another
# trusted proxy (for example Cloudflare) is in front of Plesk.
TRUST_PROXY_HOPS=1

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_NAME=<db-name>

# JWT
JWT_SECRET=<change-this-to-a-long-random-secret>
JWT_EXPIRES_IN=8h
# Security alert acknowledgement/resolution is intentionally disabled by default.
# Set to true to restore the existing API actions and frontend controls.
ENABLE_SECURITY_ALERT_RESOLUTION=false

# Login history is deleted in indexed batches once it is older than 31 days.
LOGIN_HISTORY_CLEANUP_BATCH_SIZE=1000

# Emergency database purge API. Keep disabled except during an intentional purge.
# Generate the key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENABLE_DATABASE_PURGE_API=false
DATABASE_ADMIN_KEY=<at-least-32-random-characters>
